---
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';
import { NAV, SITE, url } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (path: string) => {
  const target = url(path);
  return path === '' ? current === target : current.startsWith(target);
};

const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  'upgrade-insecure-requests',
].join('; ');
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=1200, minimum-scale=0.25, maximum-scale=5, user-scalable=yes" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href={url('img/favicon.png')} />
    <link rel="apple-touch-icon" href={url('img/apple-touch-icon.png')} />
    <meta property="og:image" content={new URL(url('img/accueil.webp'), Astro.site)} />
    <meta name="theme-color" content="#102058" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={url()}>
          <img src={url('img/logo.png')} alt="" width="40" height="40" />
          <span>{SITE.title}</span>
        </a>
        <nav id="main-nav" class="main-nav" aria-label="Menu principal">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={url(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <p class="brand-footer">
            <img src={url('img/logo.png')} alt="" width="32" height="32" />
            {SITE.title}
          </p>
          <p class="footer-tagline">{SITE.tagline}</p>
          <p>{SITE.address}</p>
          <p><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
        </div>
        <div>
          <p class="footer-title">Suivez-nous</p>
          <SocialLinks />
        </div>
        <div>
          <p class="footer-title">Liens utiles</p>
          <ul class="footer-links">
            <li><a href={url('adherer/')}>Adhérer</a></li>
            <li><a href={url('documents/')}>Espace documents</a></li>
            <li><a href={url('glossaire/')}>Glossaire syndical</a></li>
            <li><a href={url('mentions-legales/')}>Mentions légales</a></li>
          </ul>
        </div>
      </div>
      <p class="container copyright">&copy; {new Date().getFullYear()} {SITE.title}</p>
    </footer>
  </body>
</html>
