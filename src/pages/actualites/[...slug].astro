---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getActualites, type Actualite } from '../../data/actualites';
import { url } from '../../config';

export const getStaticPaths = (async () => {
  const items = await getActualites();
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}) satisfies GetStaticPaths;

interface Props {
  item: Actualite;
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<Base title={item.data.title} description={item.data.summary}>
  <article class="prose">
    <p><a href={url('actualites/')}>← Toutes les actualités</a></p>
    <h1>{item.data.title}</h1>
    <p class="meta">
      Publié le <time datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>
    </p>
    <Content />
  </article>
</Base>
