---
import Base from '../layouts/Base.astro';
import { SITE, url } from '../config';

const subject = encodeURIComponent(`Demande d’adhésion — ${SITE.title}`);
---

<Base title="Adhérer" description={`Rejoignez ${SITE.title}.`}>
  <h1>Adhérer</h1>
  <div class="prose">
    <p>Rejoindre {SITE.title}, c’est être informé, conseillé et défendu.</p>
    <h2>Pourquoi adhérer ?</h2>
    <ul>
      <li>Un accompagnement personnalisé en cas de difficulté.</li>
      <li>L’accès à l’espace documents réservé aux adhérents.</li>
      <li>Une information régulière sur vos droits.</li>
      <li>Une cotisation déductible à 66 % de l’impôt sur le revenu (crédit d’impôt).</li>
    </ul>
    <h2>Comment adhérer ?</h2>
    <ol>
      <li>Remplissez le formulaire d’adhésion ou écrivez-nous.</li>
      <li>Indiquez l’adresse de votre <strong>compte Google</strong> pour accéder aux documents.</li>
      <li>Nous vous confirmons votre adhésion et votre accès par email.</li>
    </ol>
  </div>
  <div class="hero__actions">
    {
      SITE.membershipFormUrl && (
        <a class="button" href={SITE.membershipFormUrl} target="_blank" rel="noopener noreferrer">
          Formulaire d’adhésion
        </a>
      )
    }
    <a class="button button--ghost" href={`mailto:${SITE.contactEmail}?subject=${subject}`}>
      Nous écrire
    </a>
  </div>
  <p class="note"><a href={url('contact/')}>Toutes nos coordonnées</a></p>
</Base>
