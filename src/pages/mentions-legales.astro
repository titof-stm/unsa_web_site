---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---

<Base title="Mentions légales">
  <h1>Mentions légales</h1>
  <div class="prose">
    <h2>Éditeur du site</h2>
    <p>
      {SITE.title} — {SITE.address}<br />
      Email : <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a><br />
      Directeur de la publication : <em>à compléter</em>
    </p>
    <h2>Hébergement</h2>
    <p>GitHub Pages — GitHub, Inc., 88 Colin P. Kelly Jr. Street, San Francisco, CA 94107, États-Unis.</p>
    <h2>Données personnelles</h2>
    <p>
      Ce site ne dépose aucun cookie et ne collecte aucune donnée. L’espace documents est hébergé par
      Google Drive : les adhérents y accèdent avec leur compte Google. Pour exercer vos droits (accès,
      rectification, suppression), écrivez à <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
    </p>
  </div>
</Base>
