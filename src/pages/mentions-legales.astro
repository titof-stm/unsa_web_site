---
import Base from '../layouts/Base.astro';
import { SITE, url } from '../config';
---

<Base title="Mentions légales">
  <h1>Mentions légales</h1>
  <div class="prose">
    <h2>Éditeur du site</h2>
    <p>
      {SITE.title} — {SITE.address}<br />
      Email : <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a><br />
      Directeur de la publication : <em>à compléter</em>
    </p>
    <h2>Hébergement</h2>
    <p>GitHub Pages — GitHub, Inc., 88 Colin P. Kelly Jr. Street, San Francisco, CA 94107, États-Unis.</p>
    <h2>Données personnelles</h2>
    <p>
      Ce site ne dépose aucun cookie. L’espace documents fonctionne avec des clés d’accès anonymes, sans
      nom ni email ; les documents sont stockés sur Google Drive et les notifications envoyées via Google
      Firebase. Le détail (données, durées, sous-traitants, droits) figure dans la
      <a href={url('confidentialite/')}>politique de confidentialité</a>. Pour exercer vos droits, écrivez à
      <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
    </p>
  </div>
</Base>
