---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE } from '../config';
---

<Base title="Contact" description={`Contacter ${SITE.title}.`}>
  <h1>Contact</h1>
  <ul class="cards">
    <li class="card">
      <h2>Email</h2>
      <p><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
    </li>
    <li class="card">
      <h2>Téléphone</h2>
      <p><a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></p>
    </li>
    <li class="card">
      <h2>Adresse</h2>
      <p>{SITE.address}</p>
    </li>
  </ul>
  <h2>Réseaux sociaux</h2>
  <SocialLinks size="large" />
</Base>
