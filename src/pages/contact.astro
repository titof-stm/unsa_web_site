---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE } from '../config';
import { CENTRAL_CONTACTS, SITE_CONTACTS } from '../data/livret';
---

<Base title="Contact" description={`Contacter ${SITE.title} : coordonnées générales et contacts par site.`}>
  <h1 class="page-title">Contact</h1>
  <p class="page-lead">Une question ? Rapprochez-vous de votre section ou écrivez-nous.</p>
  <ul class="cards">
    <li class="card">
      <h2>Email</h2>
      <p><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
    </li>
    <li class="card">
      <h2>Téléphone</h2>
      <p><a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></p>
    </li>
    <li class="card">
      <h2>Adresse</h2>
      <p>{SITE.address}</p>
    </li>
  </ul>

  <section aria-labelledby="central-title">
    <h2 id="central-title">Contacts centraux</h2>
    <ul class="cards">
      {
        CENTRAL_CONTACTS.map((contact) => (
          <li class="card contact-card">
            <h3>{contact.name}</h3>
            <p class="role">{contact.role}</p>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="sites-title">
    <h2 id="sites-title">Contacts par site</h2>
    <ul class="cards">
      {
        SITE_CONTACTS.map((contact) => (
          <li class="card contact-card">
            <h3>Site de {contact.site}</h3>
            <p class="role">{contact.name}</p>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="social-title">
    <h2 id="social-title">Réseaux sociaux</h2>
    <SocialLinks size="large" />
  </section>
</Base>
