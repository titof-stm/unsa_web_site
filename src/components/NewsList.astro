---
import { formatDate, type Actualite } from '../data/actualites';
import { url } from '../config';

interface Props {
  items: Actualite[];
}

const { items } = Astro.props;
---

<ul class="cards">
  {
    items.map((item) => (
      <li class="card">
        <time datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>
        <h3>
          <a href={url(`actualites/${item.id}/`)}>{item.data.title}</a>
        </h3>
        <p>{item.data.summary}</p>
      </li>
    ))
  }
</ul>
